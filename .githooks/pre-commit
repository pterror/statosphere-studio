#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

if command -v nix &>/dev/null && [ -f flake.nix ]; then
  RUN() { nix develop --command "$@"; }
else
  RUN() { "$@"; }
fi

echo "Running typecheck..."
RUN bun run typecheck

echo "Running lint:eslint..."
RUN bun run lint:eslint

echo "Running lint:style..."
RUN bun run lint:style

echo "Running build..."
RUN bun run build

echo "Running validate-recipes..."
RUN bun run scripts/validate-recipes.ts

echo "Running check-share-roundtrip..."
RUN bun run scripts/check-share-roundtrip.ts

echo "Running check-recipe-roundtrip..."
RUN bun run scripts/check-recipe-roundtrip.ts

echo "Running check-lints..."
RUN bun run scripts/check-lints.ts

echo "Running check-json-patch..."
RUN bun run scripts/check-json-patch.ts

echo "Running check-history-tree..."
RUN bun run scripts/check-history-tree.ts

echo "Running check-ui-lints..."
RUN bun run scripts/check-ui-lints.ts

echo "Pre-commit checks passed!"
