{
  "name": "@pterror/statosphere-studio",
  "version": "0.1.0",
  "type": "module",
  "files": ["dist", "schemas", "help"],
  "main": "./dist/statosphere-studio.umd.cjs",
  "module": "./dist/statosphere-studio.es.js",
  "types": "./dist/statosphere-studio.d.ts",
  "exports": {
    ".": {
      "import": "./dist/statosphere-studio.es.js",
      "require": "./dist/statosphere-studio.cjs",
      "types": "./dist/statosphere-studio.d.ts"
    },
    "./dist/style.css": "./dist/style.css"
  },
  "scripts": {
    "dev": "vite",
    "build:spa": "vite build",
    "build:lib": "vite build --mode lib",
    "build": "bun run build:spa && bun run build:lib",
    "lint": "vue-tsc --noEmit",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "validate-recipes": "bun run scripts/validate-recipes.ts",
    "lint:eslint": "eslint src scripts --max-warnings 0",
    "lint:eslint:fix": "eslint src scripts --fix",
    "lint:style": "stylelint 'src/**/*.{css,vue}'",
    "lint:style:fix": "stylelint 'src/**/*.{css,vue}' --fix"
  },
  "peerDependencies": {
    "pinia": ">=2.0.0",
    "vue": ">=3.0.0"
  },
  "dependencies": {
    "@vueuse/core": "^10.11.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "elkjs": "^0.11.1",
    "fflate": "^0.8.2",
    "marked": "^18.0.4",
    "pinia": "^2.1.7",
    "reka-ui": "^2.1.0",
    "vue": "^3.4.27"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.59.4",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/tsconfig": "^0.5.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^10.4.0",
    "eslint-plugin-vue": "^10.9.1",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "postcss": "^8.4.38",
    "postcss-html": "^1.8.1",
    "stylelint": "^17.12.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vite-plugin-dts": "^3.9.1",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^2.0.16"
  }
}
